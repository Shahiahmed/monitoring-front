# Локальная разработка: скопируйте в .env.local и задайте:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api
# Тогда запросы пойдут на бэкенд (нужен запущенный backend и CORS).
# Без этого запросы идут на localhost:3000/api и дают 404.

# Production: в .env.production задано NEXT_PUBLIC_API_BASE_URL=/api.
# Если при сборке для прода у вас есть .env.local с localhost — перед npm run build
# переименуйте .env.local или выполните: set NEXT_PUBLIC_API_BASE_URL=/api && npm run build
